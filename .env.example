# Copy to .env on the target computer and adjust as needed.
APP_TIMEZONE=Asia/Shanghai

# Dynamic watermark backend: auto, cuda, rocm, directml, cpu or opencv.
PROPAINTER_BACKEND=auto
# These paths are inside the API container, not Windows host paths.
PROPAINTER_ROOT=
PROPAINTER_PYTHON=python
PROPAINTER_ALLOW_CPU=1
PROPAINTER_FP16=1
PROPAINTER_MASK_DILATION=2
PROPAINTER_SUBVIDEO_LENGTH=80
PROPAINTER_TIMEOUT_SECONDS=3600
# For NVIDIA GPU deployment, set the host path and launch with:
# docker compose -f compose.yaml -f compose.gpu.yaml up -d --build
# Example Windows value: PROPAINTER_HOST_ROOT=D:/ProPainter-Webui
# The folder must contain ProPainter/inference_propainter.py and its weights.
PROPAINTER_HOST_ROOT=

# Whisper/semantic analysis defaults.
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
OPERATOR_SEMANTIC_WHISPER_ENABLED=true
OPERATOR_SEMANTIC_WHISPER_MAX_START_SECONDS=15
OPERATOR_SEMANTIC_SAMPLE_INTERVAL_SECONDS=3.0
OPERATOR_SEMANTIC_MAX_SAMPLES=60
OPERATOR_PROCESS_WORKERS=2
OPERATOR_ASYNC_PROCESSING=1
# Require ProPainter only when a verified ProPainter runtime is available.
DYNAMIC_WATERMARK_REQUIRE_PROPAINTER=0

# Fill credentials only on the target machine when publishing is required.
# Do not commit or share the populated file.
